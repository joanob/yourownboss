# Your Own Boss Backend - Environment Configuration

# Server Configuration
PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=./yourownboss.db

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-at-least-32-chars
JWT_SESSION_EXPIRY=60
JWT_REFRESH_EXPIRY=25920000

# Session Cache Configuration
SESSION_CACHE_CLEANUP_INTERVAL=21600

# Admin Configuration
ADMIN_PASSWORD=admin123

# Gamedata Configuration
GAMEDATA_FILE=./config/gamedata.json

# Initial Company Money
INITIAL_COMPANY_MONEY=1000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
ENV=development
